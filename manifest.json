{
    "manifest_version": 3,
    "name": "Bookmark Exporter",
    "version": "1.0",
    "description": "View and export all your browser bookmarks.",
    "permissions": [
      "bookmarks"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
      }
    }
  }
  